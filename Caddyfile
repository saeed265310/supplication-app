:80 {
    # Proxy API requests to backend (internal Docker network)
    handle /api/* {
        reverse_proxy supplication-backend:3001 {
            # Health check
            health_uri /api/health
            health_interval 10s
            health_timeout 5s

            # Preserve headers - Host is required for proper routing
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Serve static frontend files
    handle {
        root * /srv
        encode gzip

        # Try serving files, fallback to index.html for SPA routing
        try_files {path} /index.html
        file_server
    }

    # Security headers
    header {
        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"

        # Prevent clickjacking
        X-Frame-Options "DENY"

        # Control referrer information
        Referrer-Policy "strict-origin-when-cross-origin"

        # Control browser features
        Permissions-Policy "geolocation=(), microphone=(), camera=()"

        # CSP temporarily disabled for debugging
        # Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
}
