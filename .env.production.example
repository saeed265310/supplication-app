# Production Environment Variables

# Backend
JWT_SECRET=your-production-secret-key-minimum-32-characters
PORT=3001
NODE_ENV=production
# Set to your frontend domain or * for development
CORS_ORIGIN=https://yourdomain.com

# Frontend (set during Docker build)
# For nginx proxy manager, use your backend domain
VITE_API_URL=https://api.yourdomain.com/api
# Or if using same domain with proxy:
# VITE_API_URL=https://yourdomain.com/api
